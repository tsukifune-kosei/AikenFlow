use aiken/collection/list
use aiken/crypto.{VerificationKeyHash}
use aiken/interval
use cardano/transaction.{OutputReference, Transaction}

pub type LockedDatum {
  owner: VerificationKeyHash,
  amount: Int,
  deadline: Int,
}

pub type LockedRedeemer {
  Withdraw
  EmergencyCancel
}

validator simple_vault_locked {
  spend(datum_opt: Option<LockedDatum>, redeemer: LockedRedeemer, _own_ref: OutputReference, self: Transaction) {
    expect Some(datum) = datum_opt

    when redeemer is {
      Withdraw -> {
        let must_signed_by_datum_owner_1 = list.has(self.extra_signatories, datum.owner)
        let must_after_datum_deadline_2 = self.validity_range |> interval.is_entirely_after(datum.deadline)
        and {
          must_signed_by_datum_owner_1,
          must_after_datum_deadline_2,
        }
      }
      EmergencyCancel -> {
        let must_signed_by_datum_owner_1 = list.has(self.extra_signatories, datum.owner)
        let must_before_datum_deadline_2 = self.validity_range |> interval.is_entirely_before(datum.deadline)
        and {
          must_signed_by_datum_owner_1,
          must_before_datum_deadline_2,
        }
      }
    }
  }
}
